rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Security Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isActiveAdmin() {
      return isSignedIn() && (
        request.auth.token.email == "jerryagbedun@gmail.com" || (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) && (
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == "active" ||
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin"
          )
        )
      );
    }

    // --- Collections Configurations ---

    // 1. Users Collection
    match /users/{userId} {
      allow read, write: if isActiveAdmin();
    }

    // 2. Programmes Collection
    match /programmes/{docId} {
      allow read: if resource.data.status == "active" || isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // 3. ProgrammeVideos Collection
    match /programmeVideos/{docId} {
      allow read: if resource.data.status == "published" || isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // 4. Explainers Collection
    match /explainers/{docId} {
      allow read: if resource.data.status == "active" || isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // 5. ExplainerItems Collection
    match /explainerItems/{docId} {
      allow read: if resource.data.status == "published" || isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // 6. Briefings Collection
    match /briefings/{docId} {
      allow read: if resource.data.status == "published" || isActiveAdmin();
      allow write: if isActiveAdmin();
    }

    // 7. SiteSettings Collection
    match /siteSettings/{docId} {
      allow read: if true;
      allow write: if isActiveAdmin();
    }

    // 8. PartnerRequests Collection
    match /partnerRequests/{docId} {
      allow create: if true;
      allow read, update, delete: if isActiveAdmin();
    }

    // 9. NewsletterSubscribers Collection
    match /newsletterSubscribers/{docId} {
      allow create: if true;
      allow read, update, delete: if isActiveAdmin();
    }

    // 10. ContactMessages Collection
    match /contactMessages/{docId} {
      allow create: if true;
      allow read, update, delete: if isActiveAdmin();
    }
  }
}
